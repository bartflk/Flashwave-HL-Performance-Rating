{
  "name": "hl-rating",
  "private": true,
  "version": "0.4.1",
  "description": "Team Fortress 2 Highlander performance rating system",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "checksums": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/checksums.ps1",
    "ui": "npm --prefix ui run dev",
    "ui:check": "npm --prefix ui run build",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0"
  }
}
